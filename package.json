{
  "name": "@blwatkins/genart-utils",
  "version": "0.1.0-alpha.0",
  "license": "MIT",
  "private": false,
  "description": "A growing toolkit of reusable, library-agnostic TypeScript and JavaScript utilities for algorithmic generative art development.",
  "author": {
    "name": "Brittni Watkins",
    "url": "https://blwatkins.github.io/"
  },
  "homepage": "https://blwatkins.github.io/typescript-genart-utils/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blwatkins/typescript-genart-utils.git"
  },
  "bugs": {
    "url": "https://github.com/blwatkins/typescript-genart-utils/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24"
  },
  "types": "./_dist/index.d.mts",
  "module": "./_dist/index.mjs",
  "main": "./_dist/index.mjs",
  "exports": {
    ".": {
      "types": "./_dist/index.d.mts",
      "default": "./_dist/index.mjs"
    }
  },
  "files": [
    "./_dist",
    "./LICENSE",
    "./package.json",
    "./README.md"
  ],
  "scripts": {
    "lint:js": "eslint -c eslint.config.js.mjs .",
    "lint:ts": "eslint -c eslint.config.ts.mjs .",
    "lint:all": "npm run lint:js && npm run lint:ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc",
    "build": "tsdown",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@blwatkins/utils": "^0.1.0-alpha.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-es-x": "^10.0.1",
    "eslint-plugin-jsdoc": "^64.5.4",
    "globals": "^17.12.0",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.19",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
